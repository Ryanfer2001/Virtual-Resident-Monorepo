SISP_LANGUAGE=
SISP_CURRENCY=
SISP_COUNTRY_CODE=
SISP_DEFAULT_EMAIL=
SISP_DEFAULT_CITY=
SISP_DEFAULT_ADDRESS=
SISP_DEFAULT_POSTAL_CODE=
