# Variáveis de ambiente do backend (@noszona/api)
# Apenas nomes de variáveis. Nunca colocar valores reais aqui.

# Base de dados MySQL
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Porta em que a API Express arranca localmente
PORT=

# Origem(ns) permitida(s) por CORS
FRONTEND_URL=
FRONTEND_DASHBOARD_URL=

# Assina o JWT dos residentes (tem de ser o MESMO valor usado pelo
# frontend em apps/web/.env.local, ver apps/web/.env.example)
JWT_SECRET=

# --- Área administrativa -----------------------------------------------

# Credenciais usadas SÓ pelo script manual src/scripts/criarAdmin.js
# (npm run admin:seed) para criar a conta administrativa inicial
# (username "DevTeam"). Nunca são lidas fora desse script. A password
# deve ir entre aspas no .env real porque contém caracteres especiais:
#   ADMIN_BOOTSTRAP_PASSWORD="valor com caracteres especiais aqui"
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Assina o JWT administrativo (curta duração). TEM de ser diferente de
# JWT_SECRET — nunca partilhar o mesmo segredo entre residentes e admin.
ADMIN_JWT_SECRET=

# SMTP (recuperação de password / notificações)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# SISP / Vinti4 (pagamentos)
SISP_URL=
SISP_MERCHANT_ID=
SISP_POS_ID=
SISP_POS_AUT_CODE=
SISP_CURRENCY=
SISP_LANGUAGE=
SISP_COUNTRY_CODE=
SISP_TRANSACTION_CODE=
SISP_RETURN_URL=
SISP_MERCHANT_RESPONSE_URL=
SISP_DEFAULT_EMAIL=
SISP_DEFAULT_PHONE_COUNTRY_CODE=
SISP_DEFAULT_ADDRESS=
SISP_DEFAULT_CITY=
SISP_DEFAULT_POSTAL_CODE=
