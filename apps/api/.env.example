# Variáveis de ambiente do backend (@noszona/api)
# Apenas nomes de variáveis. Nunca colocar valores reais aqui.

# Servidor
PORT=
FRONTEND_URL=
FRONTEND_DASHBOARD_URL=

# Base de dados MySQL
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Autenticação
JWT_SECRET=

# Serviço de pagamento SISP / Vinti4
SISP_POS_ID=
SISP_POS_AUT_CODE=
