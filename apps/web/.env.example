# Variáveis de ambiente do frontend (@noszona/web)
# Apenas nomes de variáveis. Nunca colocar valores reais aqui.

# URL base do backend Express (@noszona/api) usada por apps/web/lib/api.ts
# para o registo de residentes e recuperação de password.
# Não deve terminar em "/" nem incluir "/api".
NEXT_PUBLIC_API_URL=

# URL do backend Express (Hostinger) usada pelas rotas internas
# app/api/residentes/login/route.ts, registar/route.ts e fotos/route.ts
# como proxy para o backend. Variável apenas server-side (não usar prefixo
# NEXT_PUBLIC_, pois estas rotas executam no servidor Next.js).
# Valor: https://darkgrey-meerkat-287167.hostingersite.com
BACKEND_API_URL=

# Segredo usado para assinar o JWT emitido por app/api/residentes/login/route.ts.
# Tem de ser o MESMO valor usado pelo backend para validar o token (JWT_SECRET em apps/api/.env).
JWT_SECRET=

# Endpoints usados no .env.local original (não referenciados diretamente no código
# lido, mas presentes no .env.local do projeto original — documentados aqui para
# não perder nenhuma variável).
NEXT_PUBLIC_REGISTO_ENDPOINT=
NEXT_PUCLIC_LOGIN_ENDPOINT=

# URL base do backend Express (apps/api) usada pelos Route Handlers da
# área administrativa (app/api/admin/**) para reencaminhar pedidos com o
# token lido do cookie HttpOnly. Nunca é exposta ao browser.
# Valor local: http://localhost:3002
ADMIN_API_BASE_URL=
